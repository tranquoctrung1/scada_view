extends ./partial/layoutNone.pug
block linkcss
	link(rel="stylesheet", href="https://unpkg.com/leaflet/dist/leaflet.css")
	link(rel="stylesheet", href="/css/leaflet/context-menu.min.css")
	link(rel="stylesheet", href="/assets/css/lib/listtree/listree.min.css")
	link(rel="stylesheet", href="https://common.olemiss.edu/_js/sweet-alert/sweet-alert.css")
	link(rel="stylesheet", href="/css/mapDMA.css")
	link(rel="stylesheet", href="/css/pageCommon.css")
block content 
	.container-fluid.map#containerMap.hideFooter
		.row.p-0.m-0
			.col.p-0
				.map#mapDMA
				.slider-container#slider
					label(for='rateRange')
					b Lọc tỷ lệ TTN
					| : 
					span#rangeVal 50
					|  %
					.slider-bar-wrapper
					input#rateRange(type='range' min='0' max='50' value='50' step='1' onchange='onRateRangeChanged(this)')
				.legend#legend.hide
					div 
						div.p-2
							img(src="/images/red.png", alt="icon red") 	
							span.ml-2
								span TTN > 25%
						div.p-2
							img(src="/images/yellow.png", alt="icon yellow") 	
							span.ml-2
								span TTN &le; 25 && TTN > 10%
						div.p-2
							img(src="/images/green.png", alt="icon green") 	
							span.ml-2 TTN &le; 10%
					div#hideLegend.hide
						span  
							i.ti-blackboard
				div#hideFooter.hide
					span
						i.ti-menu-alt
				.icon-setting
					.box-icon#config.config
						i.fa.fa-cog.fa-spin.fa-2x.fa-fw.text-danger
				#panel.panel.d-none
					#treeViewSite
						h6.text-white.text-center Tìm Kiếm 
						div.search-area
							.input-group.input-group-sm.mb-3
								input.form-control.search-input(type='text' aria-label='Sizing example input' aria-describedby='inputGroup-sizing-sm' id="searchSite")
						div 
							.box-listtree#listSite.mt-2
	.container-fluid.footer#footer.hide
		.row
			.col-md-2
				//- #loading
				//- 	img.loading(src="/images/loading.svg", alt="", srcset="")
				.text-center Top 5 TTN Cao Nhất
				canvas#barChartHighestTTN.chart
			.col-md-2
				//- #loading2
				//- 	img.loading(src="/images/loading.svg", alt="", srcset="")
				.text-center Top 5 LLTT Cao Nhất
				canvas#barChartLowestTTN.chart
			.col-md-2
				//- #loading2
				//- 	img.loading(src="/images/loading.svg", alt="", srcset="")
				.text-center TTN Năm 
					span#prevYear
					| &nbsp; và Năm 
					span#currentYear
				canvas#lineChartCompare.chart
			.col-md-2
				//- #loading3
				//- 	img.loading(src="/images/loading.svg", alt="", srcset="")
				.lost-area-total-dma
					#totalDMA.text-center
					.text-center Số lượng DMA
				.lost-area
					#totalPercentLost.text-center
					div.text-center Thất Thoát Nước Tháng 
						span#currentMonthYear
						
				.lost-area
					#totalLostWater.text-center
					div.text-center Lũy Kế Thất Thoát Đến Tháng 
						span#currentMonthYearLK
						
			.col-md-4
				.text-center Chi tiết Thất Thoát DMA
				#tableStatistic 
					//- .table.table-bordered.table-striped.table-hover
					table
						thead
							tr
								th Tên DMA
								th Cấp (m3)
								th Tiêu thụ (m3)
								th TT (%)
								th Xu hướng
						tbody#bodyTableStatistic


block linkcriptbody
	script(src='https://common.olemiss.edu/_js/sweet-alert/sweet-alert.min.js')
	script(src='https://unpkg.com/leaflet/dist/leaflet.js')
	script(src='https://unpkg.com/esri-leaflet/dist/esri-leaflet.js')
	script(src='https://cdn.jsdelivr.net/npm/chart.js')
	script(src='https://unpkg.com/terraformer')
	script(src='https://unpkg.com/terraformer-arcgis-parser')
	script(src='/js/leaflet/context-menu.js')
	script(src="/js/leaflet/proj4.js")
	script(src='/axios/axios.min.js')
	script(src='/js/hostname.js')
	script(src='/js/mapDMA.js')
	script(src='/js/util.js')
	